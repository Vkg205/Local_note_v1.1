<Window x:Class="LocalNote.App.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Width="560" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="颜色" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="选择常用色，或使用自定义画板精确取色。" Margin="0,5,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="13" CornerRadius="10"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="常用颜色" FontWeight="SemiBold" Margin="1,0,0,10"/>
                <WrapPanel x:Name="PresetPanel"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="自定义画板" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Width="292" Height="196" CornerRadius="7" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Grid x:Name="ColorBoard" Width="290" Height="194"
                          MouseLeftButtonDown="ColorBoard_MouseLeftButtonDown"
                          MouseMove="ColorBoard_MouseMove">
                        <Rectangle x:Name="HueBase" Fill="#FF0000"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="PickerMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,28,8,0">
                <Border Width="18" Height="196" CornerRadius="7" ClipToBounds="True" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FF00FF" Offset="0.17"/>
                            <GradientStop Color="#0000FF" Offset="0.34"/><GradientStop Color="#00FFFF" Offset="0.5"/>
                            <GradientStop Color="#00FF00" Offset="0.67"/><GradientStop Color="#FFFF00" Offset="0.84"/>
                            <GradientStop Color="#FF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Slider x:Name="HueSlider" Orientation="Vertical" Minimum="0" Maximum="360" Value="0"
                            IsDirectionReversed="True" ValueChanged="HueSlider_ValueChanged"
                            Background="Transparent" Opacity="0.72"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="12,27,0,0">
                <TextBlock Text="当前颜色" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border x:Name="PreviewBorder" Height="72" Margin="0,7,0,18" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                <TextBlock Text="HEX" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBox x:Name="HexBox" Margin="0,5,0,0" Padding="8,6" FontFamily="Consolas" FontSize="13"
                         LostKeyboardFocus="HexBox_LostKeyboardFocus" PreviewKeyDown="HexBox_PreviewKeyDown"/>
                <TextBlock x:Name="RgbText" Margin="0,9,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource CommandButton}" Content="取消" Width="82" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="确定" Width="88" Margin="8,2,2,2" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
