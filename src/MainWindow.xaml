<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LocalNote.App.Controls" x:Class="LocalNote.App.MainWindow" Title="LocalNote · 本地数字笔记本" Height="940" Width="1580" MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen" Icon="LocalNote.ico" Background="{DynamicResource AppBackgroundBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition x:Name="RibbonRow" Height="112" MinHeight="106" MaxHeight="170"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Brand/title bar -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid Margin="10,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavToggleButton" Style="{StaticResource TopBarButton}" Content="☰" FontSize="15" Click="ToggleNavigation_Click" ToolTip="显示/隐藏笔记本导航"/>
                    <Border Background="White" Width="30" Height="30" CornerRadius="7" Margin="8,0,9,0">
                        <TextBlock Text="L" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LocalNote" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="本地数字笔记本" Foreground="#DCCCE8" FontSize="9.5" Margin="0,-1,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VaultSummary}" Foreground="#DCCFE6" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" FontSize="11.5"/>
                </StackPanel>

                <Grid Grid.Column="1" MinWidth="220" MaxWidth="440" Margin="14,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border Background="#24FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SearchScopeCombo" SelectedIndex="0" Margin="2" Padding="7,4" MinHeight="34" SelectionChanged="SearchScopeCombo_SelectionChanged">
                                <ComboBoxItem Content="整个仓库"/><ComboBoxItem Content="当前笔记本"/><ComboBoxItem Content="当前分区"/><ComboBoxItem Content="当前页"/>
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchTextBox}" BorderThickness="0" Background="Transparent" TextChanged="SearchBox_TextChanged" ToolTip="搜索标题、文本和表格 (Ctrl+F)"/>
                            <TextBlock Grid.Column="1" Text="⌕  搜索笔记、页面和内容…" Foreground="#DCCFE6" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="1" CornerRadius="10" Padding="6" Width="422" MaxHeight="410">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                            <ListBox x:Name="SearchResults" MouseDoubleClick="SearchResults_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RibbonCompactButton" Style="{StaticResource TopBarButton}" Content="⌃ 工具" Click="ToggleRibbon_Click" ToolTip="折叠/展开工具栏；也可拖动下方分隔线调整高度"/>
                    <Button x:Name="PagesPaneButton" Style="{StaticResource TopBarButton}" Content="▤ 页面" Click="TogglePagesPane_Click" ToolTip="显示/隐藏页面列表"/>
                    <Button x:Name="FocusModeButton" Style="{StaticResource TopBarButton}" Content="⛶ 专注" Click="ToggleFocusMode_Click" ToolTip="专注模式：尽量把空间留给画布"/>
                    <Button Style="{StaticResource TopBarButton}" Content="⟳" Click="Backup_Click" ToolTip="创建本地备份"/>
                    <Button Style="{StaticResource TopBarButton}" Content="♻" Click="Trash_Click" ToolTip="查看回收站"/>
                    <Menu Background="Transparent" BorderThickness="0" Foreground="White" Margin="2,0,0,0">
                        <MenuItem Header="文件 ▾" Padding="10,7" Foreground="White">
                            <MenuItem Header="创建本地仓库…" Foreground="{DynamicResource TextPrimaryBrush}" Command="{Binding CreateVaultCommand}"/>
                            <MenuItem Header="打开本地仓库…" Foreground="{DynamicResource TextPrimaryBrush}" Command="{Binding OpenVaultCommand}"/>
                            <Separator/>
                            <MenuItem Header="创建备份…" Foreground="{DynamicResource TextPrimaryBrush}" Click="Backup_Click"/>
                            <MenuItem Header="从备份恢复…" Foreground="{DynamicResource TextPrimaryBrush}" Click="RestoreBackup_Click"/>
                            <MenuItem Header="检查仓库完整性…" Foreground="{DynamicResource TextPrimaryBrush}" Click="Integrity_Click"/>
                            <Separator/>
                            <MenuItem Header="导出当前页 PDF…" Foreground="{DynamicResource TextPrimaryBrush}" Click="ExportPdf_Click"/>
                            <Separator/>
                            <MenuItem Header="关于 LocalNote" Foreground="{DynamicResource TextPrimaryBrush}" Click="About_Click"/>
                            <MenuItem Header="退出" Foreground="{DynamicResource TextPrimaryBrush}" Click="Exit_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Office/OneNote-inspired ribbon. Height can be resized/collapsed to maximize canvas. -->
        <TabControl Grid.Row="1" x:Name="RibbonTabs" Style="{StaticResource RibbonTabControl}" IsEnabled="{Binding IsVaultOpen}" SelectedIndex="0">
            <TabItem Header="首页" Style="{StaticResource RibbonTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="↶" FontSize="17" Click="Undo_Click" ToolTip="撤销"/>
                                    <Button Style="{StaticResource CommandButton}" Content="↷" FontSize="17" Click="Redo_Click" ToolTip="重做"/>
                                </StackPanel>
                                <TextBlock Text="撤销" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>

                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0">
                                    <Button Style="{StaticResource CommandButton}" Content="B" FontWeight="Bold" Click="Bold_Click" ToolTip="粗体"/>
                                    <Button Style="{StaticResource CommandButton}" Content="I" FontStyle="Italic" Click="Italic_Click" ToolTip="斜体"/>
                                    <Button Style="{StaticResource CommandButton}" Content="U̲" Click="Underline_Click" ToolTip="下划线"/>
                                    <Button Style="{StaticResource CommandButton}" Content="S̶" Click="Strikethrough_Click" ToolTip="删除线"/>
                                    <Button Style="{StaticResource CommandButton}" Content="x²" Click="Superscript_Click" ToolTip="上标"/>
                                    <Button Style="{StaticResource CommandButton}" Content="x₂" Click="Subscript_Click" ToolTip="下标"/>
                                    <Button Style="{StaticResource CommandButton}" Content="橡皮" Click="ClearFormatting_Click" ToolTip="清除文本格式"/>
                                    <ComboBox x:Name="TextStyleCombo" Width="82" Style="{StaticResource ToolbarCombo}" SelectedIndex="0" SelectionChanged="TextStyleCombo_SelectionChanged" ToolTip="段落样式">
                                        <ComboBoxItem Content="正文"/><ComboBoxItem Content="标题 1"/><ComboBoxItem Content="标题 2"/><ComboBoxItem Content="标题 3"/>
                                        <ComboBoxItem Content="标题 4"/><ComboBoxItem Content="标题 5"/><ComboBoxItem Content="标题 6"/><ComboBoxItem Content="引用"/>
                                    </ComboBox>
                                    <ComboBox x:Name="FontSizeCombo" Width="66" Style="{StaticResource ToolbarCombo}" SelectedIndex="3" SelectionChanged="FontSizeCombo_SelectionChanged">
                                        <ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="22"/><ComboBoxItem Content="28"/><ComboBoxItem Content="36"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="TextColor_Click" ToolTip="文字颜色 · 点击打开自定义画板">
                                        <StackPanel><TextBlock Text="A" FontWeight="SemiBold" HorizontalAlignment="Center"/><Border x:Name="TextColorPreview" Height="4" Background="#2563EB" CornerRadius="2" Margin="2,1,2,0"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="HighlightColor_Click" ToolTip="文本高亮颜色 · 点击打开自定义画板">
                                        <Border x:Name="HighlightColorPreview" Background="#FFEE99" CornerRadius="4" Padding="6,3"><TextBlock Text="ab" FontWeight="SemiBold"/></Border>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="基本文本" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>

                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="•" Click="Bullets_Click" ToolTip="项目符号"/>
                                    <Button Style="{StaticResource CommandButton}" Content="1." Click="Numbering_Click" ToolTip="编号列表"/>
                                    <Button Style="{StaticResource CommandButton}" Content="☐" Click="ToggleTodo_Click" ToolTip="当前段落设为/取消待办；待办中回车自动创建下一条"/>
                                    <Button Style="{StaticResource CommandButton}" Content="≡←" Click="AlignLeft_Click" ToolTip="左对齐"/>
                                    <Button Style="{StaticResource CommandButton}" Content="≡↔" Click="AlignCenter_Click" ToolTip="居中"/>
                                    <Button Style="{StaticResource CommandButton}" Content="≡→" Click="AlignRight_Click" ToolTip="右对齐"/>
                                    <Button Style="{StaticResource CommandButton}" Content="⇥" Click="IndentIncrease_Click" ToolTip="增加缩进"/>
                                    <Button Style="{StaticResource CommandButton}" Content="⇤" Click="IndentDecrease_Click" ToolTip="减少缩进"/>
                                    <ComboBox x:Name="LineSpacingCombo" Width="68" Style="{StaticResource ToolbarCombo}" SelectedIndex="0" SelectionChanged="LineSpacingCombo_SelectionChanged" ToolTip="行距">
                                        <ComboBoxItem Content="1.0"/><ComboBoxItem Content="1.25"/><ComboBoxItem Content="1.5"/><ComboBoxItem Content="2.0"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="段落" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>

                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="★ 重要" Click="ToggleImportant_Click" ToolTip="给整个对象添加重要标记"/>
                                    <Button Style="{StaticResource CommandButton}" Content="🔗 链接" Click="InsertHyperlink_Click" ToolTip="给选中的文字添加外部链接"/>
                                </StackPanel>
                                <TextBlock Text="标记与链接" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="插入" Style="{StaticResource RibbonTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RibbonLargeButton}" Click="AddText_Click" ToolTip="在当前视口插入富文本块">
                                        <StackPanel><TextBlock Text="T" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="文本块" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeButton}" Click="AddTable_Click" ToolTip="插入带表头的表格">
                                        <StackPanel><TextBlock Text="▦" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="表格" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeButton}" Click="AddImage_Click">
                                        <StackPanel><TextBlock Text="▧" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="图片" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeButton}" Click="AddAttachment_Click">
                                        <StackPanel><TextBlock Text="📎" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="附件" FontSize="11"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="页面内容" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="↗ 移动页面" Click="MovePage_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="⧉ 复制页面" Click="CopyPage_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="⌃ 置顶" Click="PinPage_Click"/>
                                </StackPanel>
                                <TextBlock Text="页面" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="绘图" Style="{StaticResource RibbonTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <ToggleButton x:Name="SelectToolToggle" Style="{StaticResource RibbonToolToggle}" Content="⌖ 选择" IsChecked="True" Click="SelectTool_Click"/>
                                    <ToggleButton x:Name="PenToolToggle" Style="{StaticResource RibbonToolToggle}" Content="✎ 钢笔" Click="PenTool_Click"/>
                                    <ToggleButton x:Name="PencilToolToggle" Style="{StaticResource RibbonToolToggle}" Content="✐ 铅笔" Click="PencilTool_Click"/>
                                    <ToggleButton x:Name="HighlighterToolToggle" Style="{StaticResource RibbonToolToggle}" Content="▰ 荧光笔" Click="HighlighterTool_Click"/>
                                    <ToggleButton x:Name="EraserToolToggle" Style="{StaticResource RibbonToolToggle}" Content="⌫ 橡皮" Click="EraserTool_Click"/>
                                    <ToggleButton x:Name="InkSelectToolToggle" Style="{StaticResource RibbonToolToggle}" Content="⌁ 套索" Click="InkSelectTool_Click"/>
                                </StackPanel>
                                <TextBlock Text="工具" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0">
                                    <ComboBox x:Name="InkSizeCombo" MinWidth="84" Style="{StaticResource ToolbarCombo}" SelectedIndex="4" SelectionChanged="InkSizeCombo_SelectionChanged" ToolTip="笔迹粗细">
                                        <ComboBoxItem Content="0.5"/><ComboBoxItem Content="0.8"/><ComboBoxItem Content="1.2"/><ComboBoxItem Content="1.5"/><ComboBoxItem Content="2.2"/><ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/><ComboBoxItem Content="5.5"/><ComboBoxItem Content="7"/><ComboBoxItem Content="10"/><ComboBoxItem Content="14"/><ComboBoxItem Content="20"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="InkColor_Click" ToolTip="墨迹颜色 · 点击打开自定义画板">
                                        <StackPanel Orientation="Horizontal"><Border x:Name="InkColorPreview" Width="18" Height="18" CornerRadius="9" Background="#202124" Margin="0,0,5,0"/><TextBlock Text="颜色" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CommandButton}" Content="清除墨迹" MinWidth="78" Click="ClearInk_Click"/>
                                </StackPanel>
                                <TextBlock Text="笔迹" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0">
                                    <ComboBox x:Name="ShapeKindCombo" MinWidth="140" Style="{StaticResource ToolbarCombo}" SelectedIndex="2" SelectionChanged="ShapeKindCombo_SelectionChanged" ToolTip="选择形状；然后在画布空白区域按住并拖动绘制">
                                        <ComboBoxItem Content="直线" Tag="Line"/><ComboBoxItem Content="箭头" Tag="Arrow"/><ComboBoxItem Content="矩形" Tag="Rectangle"/>
                                        <ComboBoxItem Content="圆角矩形" Tag="RoundedRectangle"/><ComboBoxItem Content="椭圆" Tag="Ellipse"/><ComboBoxItem Content="三角形" Tag="Triangle"/>
                                        <ComboBoxItem Content="菱形" Tag="Diamond"/><ComboBoxItem Content="流程框" Tag="Flowchart"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="ShapeStrokeColor_Click" ToolTip="形状线条颜色 · 点击打开自定义颜色画板">
                                        <StackPanel Orientation="Horizontal"><Border x:Name="ShapeStrokeColorPreview" Width="18" Height="4" Background="#6C2AA5" CornerRadius="2" Margin="0,0,5,0"/><TextBlock Text="线"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="ShapeFillColor_Click" ToolTip="形状填充颜色 · 点击打开自定义颜色画板">
                                        <StackPanel Orientation="Horizontal"><Border x:Name="ShapeFillColorPreview" Width="18" Height="18" Background="#EDE3F7" CornerRadius="4" Margin="0,0,5,0"/><TextBlock Text="填"/></StackPanel>
                                    </Button>
                                    <ComboBox x:Name="ShapeThicknessCombo" MinWidth="76" Style="{StaticResource ToolbarCombo}" SelectedIndex="2" SelectionChanged="ShapeThicknessCombo_SelectionChanged" ToolTip="形状线宽">
                                        <ComboBoxItem Content="1"/><ComboBoxItem Content="1.5"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="形状" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="视图" Style="{StaticResource RibbonTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><ComboBox x:Name="PaperStyleCombo" Width="112" Style="{StaticResource ToolbarCombo}" SelectedIndex="0" SelectionChanged="PaperStyleCombo_SelectionChanged" Grid.Row="0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="空白"/><ComboBoxItem Content="网格"/><ComboBoxItem Content="横线"/><ComboBoxItem Content="点阵"/>
                                </ComboBox>
                                <TextBlock Text="纸张" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="适应内容" Click="FitContent_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="−" Click="ZoomOut_Click"/>
                                    <Button x:Name="ZoomResetButton" Style="{StaticResource CommandButton}" Content="100%" Click="ZoomReset_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="＋" Click="ZoomIn_Click"/>
                                </StackPanel>
                                <TextBlock Text="缩放" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="☰ 导航" Click="ToggleNavigation_Click" ToolTip="显示/隐藏笔记本导航"/>
                                    <Button Style="{StaticResource CommandButton}" Content="▤ 页面" Click="TogglePagesPane_Click" ToolTip="显示/隐藏页面列表"/>
                                    <Button Style="{StaticResource CommandButton}" Content="⌃ 工具" Click="ToggleRibbon_Click" ToolTip="折叠/展开工具栏"/>
                                    <Button Style="{StaticResource CommandButton}" Content="⛶ 专注" Click="ToggleFocusMode_Click" ToolTip="F11 专注模式"/>
                                </StackPanel>
                                <TextBlock Text="界面布局 · 分隔线可拖动" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Contextual table tools. Shown only when a table is selected, like OneNote table tools. -->
            <TabItem x:Name="TableToolsTab" Header="表格" Style="{StaticResource RibbonTabItem}" Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="↑ 上方插入行" Click="TableRowAbove_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="↓ 下方插入行" Click="TableRowBelow_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="删除行" Click="TableDeleteRow_Click"/>
                                </StackPanel>
                                <TextBlock Text="行" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CommandButton}" Content="← 左侧插入列" Click="TableColumnLeft_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="→ 右侧插入列" Click="TableColumnRight_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="删除列" Click="TableDeleteColumn_Click"/>
                                    <Button Style="{StaticResource CommandButton}" Content="列宽−" Click="TableNarrowColumn_Click" ToolTip="缩窄当前列"/>
                                    <Button Style="{StaticResource CommandButton}" Content="列宽＋" Click="TableWidenColumn_Click" ToolTip="加宽当前列"/>
                                </StackPanel>
                                <TextBlock Text="列" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0">
                                    <ComboBox x:Name="TableStyleCombo" Width="126" Style="{StaticResource ToolbarCombo}" SelectedIndex="0" SelectionChanged="TableStyleCombo_SelectionChanged">
                                        <ComboBoxItem Content="柔和紫"/><ComboBoxItem Content="强调紫"/><ComboBoxItem Content="中性灰"/><ComboBoxItem Content="清爽蓝"/><ComboBoxItem Content="极简"/>
                                    </ComboBox>
                                    <ToggleButton x:Name="TableHeaderToggle" Style="{StaticResource RibbonToolToggle}" Content="表头" IsChecked="True" Click="TableHeaderToggle_Click" ToolTip="显示/隐藏表头名称行"/>
                                    <ToggleButton x:Name="TableBandToggle" Style="{StaticResource RibbonToolToggle}" Content="交替行" Click="TableBandToggle_Click"/>
                                    <ToggleButton x:Name="TableBordersToggle" Style="{StaticResource RibbonToolToggle}" Content="边框" IsChecked="True" Click="TableBordersToggle_Click"/>
                                </StackPanel>
                                <TextBlock Text="表格样式" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                        <Border Style="{StaticResource RibbonGroupBorder}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="42"/><RowDefinition Height="18"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="TableHeaderColor_Click" ToolTip="表头底色 · 自定义画板"><StackPanel><TextBlock Text="表头" FontSize="10"/><Border x:Name="TableHeaderColorPreview" Height="5" Background="#F0E5F8" CornerRadius="2"/></StackPanel></Button>
                                    <Button Style="{StaticResource ColorSwatchButton}" Click="TableBorderColor_Click" ToolTip="边框颜色 · 自定义画板"><StackPanel><TextBlock Text="边框" FontSize="10"/><Border x:Name="TableBorderColorPreview" Height="5" Background="#DDD6E1" CornerRadius="2"/></StackPanel></Button>
                                    <Button Style="{StaticResource CommandButton}" Content="左" Click="TableAlignLeft_Click" ToolTip="左对齐"/>
                                    <Button Style="{StaticResource CommandButton}" Content="中" Click="TableAlignCenter_Click" ToolTip="居中"/>
                                    <Button Style="{StaticResource CommandButton}" Content="右" Click="TableAlignRight_Click" ToolTip="右对齐"/>
                                </StackPanel>
                                <TextBlock Text="格式" Grid.Row="1" Style="{StaticResource RibbonGroupLabel}"/>
                            </Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <GridSplitter x:Name="RibbonSplitter" Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#ECE8EF" Cursor="SizeNS" ToolTip="拖动调整工具栏高度"/>

        <!-- Workspace: notebooks on the left, horizontal section tabs, page list, canvas -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition x:Name="SectionTabsRow" Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="220"/><ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="PagesColumn" Width="276"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Grid.Column="0" x:Name="NavigationPanel" Background="#F8F7FA" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="0,0,1,0" IsEnabled="{Binding IsVaultOpen}">
                <DockPanel Margin="10,12">
                    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="当前笔记本" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding SelectedNotebook.Name, TargetNullValue=未选择}" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Grid DockPanel.Dock="Top" Margin="3,0,3,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="笔记本" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource NavActionButton}" Content="＋" Command="{Binding AddNotebookCommand}" ToolTip="新建笔记本"/>
                            <Button Style="{StaticResource NavActionButton}" Content="✎" Command="{Binding RenameNotebookCommand}" ToolTip="重命名笔记本"/>
                            <Button Style="{StaticResource NavActionButton}" Content="×" Command="{Binding DeleteNotebookCommand}" ToolTip="删除笔记本"/>
                        </StackPanel>
                    </Grid>
                    <ListBox ItemsSource="{Binding Notebooks}" SelectedItem="{Binding SelectedNotebook}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="NavigationSplitter" Grid.RowSpan="2" Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Horizontal section tabs -->
            <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Background="White" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="0,0,0,1" IsEnabled="{Binding IsVaultOpen}">
                <DockPanel Margin="8,4,10,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,4">
                        <Button Style="{StaticResource NavActionButton}" Content="＋ 分区" Command="{Binding AddSectionCommand}" ToolTip="新建分区"/>
                        <Button Style="{StaticResource NavActionButton}" Content="✎" Command="{Binding RenameSectionCommand}" ToolTip="重命名分区"/>
                        <Button Style="{StaticResource NavActionButton}" Content="🎨" Click="SectionColor_Click" ToolTip="更改分区颜色"/>
                        <Button Style="{StaticResource NavActionButton}" Content="×" Command="{Binding DeleteSectionCommand}" ToolTip="删除分区"/>
                    </StackPanel>
                    <ListBox Style="{StaticResource SectionTabsList}" ItemContainerStyle="{StaticResource SectionTabItem}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color, Converter={StaticResource HexColorBrushConverter}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="0,0,1,0" IsEnabled="{Binding IsVaultOpen}">
                <DockPanel Margin="8,10">
                    <Grid DockPanel.Dock="Top" Margin="5,0,5,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="页面" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <Border Background="#F0EDF3" CornerRadius="7" Margin="8,0,0,0" Padding="6,2"><TextBlock Text="自动保存" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/></Border>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="＋ 新建页" Command="{Binding AddPageCommand}"/>
                    </Grid>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="0,1,0,0" Padding="3,8,3,0" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource NavActionButton}" Content="⌃" Click="PinPage_Click" ToolTip="置顶/取消置顶"/>
                            <Button Style="{StaticResource NavActionButton}" Content="↗" Click="MovePage_Click" ToolTip="移动页面"/>
                            <Button Style="{StaticResource NavActionButton}" Content="⧉" Click="CopyPage_Click" ToolTip="复制页面"/>
                            <Button Style="{StaticResource NavActionButton}" Content="×" Command="{Binding DeletePageCommand}" ToolTip="删除页面"/>
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" ItemContainerStyle="{StaticResource PageListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="0,2,0,2">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,1,5,1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="★" Foreground="#D99A17" Margin="6,0,2,0" VerticalAlignment="Top">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="PagesSplitter" Grid.Row="1" Grid.Column="3" Width="4" Background="Transparent" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Canvas -->
            <Grid Grid.Row="1" Grid.Column="4" Background="#ECEBF0" IsEnabled="{Binding IsVaultOpen}">
                <Grid.RowDefinitions><RowDefinition x:Name="PageHeaderRow" Height="66" MinHeight="60" MaxHeight="120"/><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="0,0,0,1" Padding="20,7,16,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBox x:Name="PageTitleBox" Style="{StaticResource PageTitleBox}" Text="{Binding SelectedPage.Title, Mode=OneWay, TargetNullValue=请选择或新建页面}" LostKeyboardFocus="PageTitleBox_LostKeyboardFocus" PreviewKeyDown="PageTitleBox_PreviewKeyDown"/>
                            <StackPanel Orientation="Horizontal" Margin="1,3,0,0">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"><Run Text="{Binding SelectedNotebook.Name, TargetNullValue=—}"/><Run Text="  ›  "/><Run Text="{Binding SelectedSection.Name, TargetNullValue=—}"/></TextBlock>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="7,2" Margin="12,-2,0,0"><TextBlock x:Name="CanvasModeText" Text="选择模式" Foreground="{DynamicResource AccentStrongBrush}" FontSize="10.5"/></Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CommandButton}" Content="删除对象" Click="DeleteObject_Click" ToolTip="删除当前选中对象"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" ToolTip="拖动调整页面标题区高度"/>
                <Border Grid.Row="2" Margin="10,8,10,10" Background="White" CornerRadius="10" BorderBrush="#DDD8E2" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.07"/></Border.Effect>
                    <controls:PageCanvasView x:Name="CanvasView" Margin="1"/>
                </Border>
            </Grid>

            <!-- Start Center -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="5" x:Name="WelcomeOverlay" Background="#E5F4F3F6" Panel.ZIndex="50">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVaultOpen}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border Style="{StaticResource WelcomeCard}" Width="640" MaxHeight="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Width="58" Height="58" Background="{DynamicResource AccentBrush}" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="L" Foreground="White" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="欢迎使用 LocalNote" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="纯本地、自由画布的 Windows 数字笔记本。创建或打开一个 Vault 后即可开始。" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22"/></StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource PrimaryButton}" Content="＋ 创建本地笔记本" Command="{Binding CreateVaultCommand}" MinWidth="170"/><Button Style="{StaticResource CommandButton}" Content="打开已有 Vault…" Command="{Binding OpenVaultCommand}" Margin="10,2,2,2" MinWidth="150"/></StackPanel>
                        <Border Grid.Row="3" Background="#F8F5FA" CornerRadius="10" Padding="13" Margin="0,24,0,0"><TextBlock Text="数据只保存在你选择的本机目录。LocalNote 不要求账号，也不会自动上传笔记。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushLocal}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="SelectionStatusText" Text="未选择对象" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,16,0"/><TextBlock Text="Windows x64 · 本地优先 · 自动保存" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
